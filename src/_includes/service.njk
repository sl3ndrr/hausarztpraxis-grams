---
layout: base.njk
---
<div class="shell article-shell">
  {% set service = praxis.services[serviceKey] %}
  <nav class="parent-navigation" aria-label="Übergeordneter Bereich">
    <a href="{{ '/#patientenservice' | url }}">Patientenservice auf der Startseite</a>
  </nav>
  <article class="reading">
    <h1>{{ service.title }}</h1>
    <p class="lead">{{ service.description }}</p>
    <p>{{ praxis.serviceProcessing }}</p>
    <div class="service-action">
    {% if service.formAvailable %}
      {% include 'formular-link.njk' %}
      <p>Das Formular öffnet sich auf der aktuellen Praxiswebsite. Dort geben Sie Ihre Daten ein.</p>
    {% else %}
      <p>{% include 'formular-link.njk' %}</p>
    {% endif %}
    </div>
    {% if service.formAvailable %}
    <p>Bei Fragen erreichen Sie die Praxis unter <a href="{{ praxis.phone.href }}">{{ praxis.phone.display }}</a>.</p>
    {% endif %}
  </article>
</div>
