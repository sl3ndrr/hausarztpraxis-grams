{% from 'icons.njk' import icon %}
{% if service.formAvailable %}
<a class="button button--primary form-link" href="{{ service.form | escape }}">{{ service.action | escape }} (extern) {{ icon('external') }}</a>
{% else %}
<p class="form-fallback">Das Formular ist derzeit nicht erreichbar. Bitte rufen Sie uns an unter <a href="{{ praxis.phone.href }}">{{ praxis.phone.display }}</a>.</p>
{% endif %}
