---
layout: base.njk
section: start
---
{% from 'icons.njk' import icon, daffodil %}
<div class="shell home">
  <div class="hero">
    <section class="praxis-intro" aria-labelledby="praxisname">
      {{ daffodil() }}
      <p class="location">{{ icon('pin') }} {{ praxis.address.district }}</p>
      <h1 id="praxisname">{{ praxis.name }}</h1>
      <p class="hero-description">{{ praxis.description }}</p>
      <div class="hero-actions">
        <a class="button button--primary" href="{{ praxis.phone.href }}">
          {{ icon('phone') }} <span>Anrufen <span class="phone-number">{{ praxis.phone.display }}</span></span>
        </a>
        <a class="action-link" href="#patientenservice">Patientenservice {{ icon('arrow') }}</a>
      </div>
    </section>
    {% include 'sprechzeiten.njk' %}
  </div>

  {% include 'service-assistent.njk' %}

  <section class="home-section" aria-labelledby="leistungen-titel">
    <div class="section-heading">
      <h2 id="leistungen-titel">Leistungen</h2>
      <a class="action-link" href="{{ '/Leistungen/' | url }}">Alle Leistungen {{ icon('arrow') }}</a>
    </div>
    <ul class="area-grid">
      {% for area in leistungen %}
      <li class="area-card">
        <a href="{{ area.path | url }}">
          <span class="icon-chip">{{ icon(area.icon) }}</span>
          <div>
            <h3>{{ area.title }}</h3>
            <p>{{ area.summary }}</p>
          </div>
          {{ icon('arrow') }}
        </a>
      </li>
      {% endfor %}
    </ul>
  </section>

  <div class="home-section practice-grid">
    <section class="practice-card" aria-labelledby="team-titel">
      <span class="icon-chip">{{ icon('person') }}</span>
      <h2 id="team-titel">Arzt und Team</h2>
      <p><strong>{{ praxis.doctor }}</strong> · {{ praxis.description }}</p>
      <p>{{ praxis.teachingPractice }}.</p>
      <a class="action-link" href="{{ '/Arzt/' | url }}">Praxisteam kennenlernen {{ icon('arrow') }}</a>
    </section>
    <section class="practice-card" aria-labelledby="anfahrt-titel">
      <span class="icon-chip">{{ icon('bus') }}</span>
      <h2 id="anfahrt-titel">Anfahrt</h2>
      <address>{{ praxis.address.street }}<br>{{ praxis.address.city }}</address>
      <a class="action-link" href="{{ '/Anfahrt/' | url }}">Anfahrt und Zugang {{ icon('arrow') }}</a>
    </section>
  </div>
</div>
